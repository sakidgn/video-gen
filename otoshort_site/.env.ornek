# Bu dosyayı ".env" adıyla kopyala ve doldur.
SITE_ADI=Cutless
# Uzun ve rastgele bir şey yaz (oturum güvenliği için şart). Örn: python -c "import secrets;print(secrets.token_urlsafe(48))"
GIZLI_ANAHTAR=
# Google AI Studio'dan alınan, faturalandırması (kart) açık API anahtarı
GEMINI_API_KEY=
# Google ile giriş (isteğe bağlı, kurulumu BENIOKU.md'de). Boşsa Google butonu görünmez.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sitenin adresi (Google dönüş adresi için), ör. https://cutless.app
SITE_ADRESI=
# Sunucu kurulumu (docker compose) için sadece alan adı, ör. cutless.app (https sertifikası bununla alınır)
ALAN_ADI=
# E-posta gönderimi (doğrulama, şifre sıfırlama, bildirimler). Boşsa e-postalar gönderilmez, saas_veri/epostalar'a kaydedilir.
# Ör. Brevo/Resend/Gmail SMTP bilgileri:
SMTP_SUNUCU=
SMTP_PORT=587
SMTP_KULLANICI=
SMTP_SIFRE=
SMTP_GONDEREN=bildirim@alanadin.com
# Yönetim paneline girebilecek e-postalar (virgülle)
ADMIN_EPOSTALAR=senin@epostan.com
# Havale bilgileri (kredi sayfasında görünür)
IBAN=TR00 0000 0000 0000 0000 0000 00
IBAN_ALICI=Ad Soyad
# Yasal sayfalarda (kullanım şartları, KVKK, mesafeli satış) görünen satıcı bilgileri
SIRKET_UNVANI=
SIRKET_ADRESI=
VERGI_BILGISI=
ILETISIM_EPOSTA=
YASAL_TARIH=
SUNUCU_SAGLAYICI=
# Açılış öncesi: ana sayfada erken erişim listesi (1 = açık) ve listedekilere kayıtta hediye kredi
ERKEN_ERISIM=0
ERKEN_ERISIM_HEDIYE=100
# Ana sayfadaki kayıtsız senaryo denemesi: günde en fazla kaç deneme (metin modeli maliyet tavanı)
DENEME_GUNLUK_SINIR=300
# Yeni kayıt olana hediye kredi (0 = yok)
KAYIT_HEDIYE_KREDI=0
# Verilerin (veritabanı + videolar) tutulduğu klasör
VERI_KLASORU=/veri
# Geliştirme için: 1 yaparsan API'ye gitmeden sahte video üretir
SAHTE_AI=0

# --- Video modelleri (her kalite farklı firmadan olabilir) ---
# Ön ek yoksa ya da "google:" ise Google Veo (GEMINI_API_KEY gerekir); "fal:" ise fal.ai (FAL_KEY gerekir).
# MODEL_LITE=veo-3.1-lite-generate-preview
# MODEL_FAST=fal:fal-ai/kling-video/v3/pro/text-to-video
# MODEL_FAST_ARGS={"duration": "5"}
# MODEL_FAST_REF=fal-ai/kling-video/v3/pro/image-to-video   (referans karakter için; Veo kendisi destekler)
# MODEL_STANDARD=veo-3.1-generate-preview
# FAL_KEY=
# Kalite başına kredi ve yönetim panelindeki kâr tahmini için maliyet (8 sn, USD):
# KREDI_LITE=35   KREDI_FAST=65   KREDI_STANDARD=250
# MALIYET_LITE=0.40   MALIYET_FAST=0.80   MALIYET_STANDARD=3.20   DOLAR_KURU=42

# --- Otomatik paylaşım (boşsa o platform "Çok yakında" görünür) ---
# YouTube: Google ile girişteki GOOGLE_CLIENT_ID/SECRET kullanılır (YouTube Data API v3 açık olmalı,
#          yönlendirme adresi: https://ALANADIN/baglan/youtube/donus)
# TikTok (developers.tiktok.com → Content Posting API, yönlendirme: https://ALANADIN/baglan/tiktok/donus):
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Instagram (developers.facebook.com → Instagram API with Instagram Login, yönlendirme: https://ALANADIN/baglan/instagram/donus):
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
