# Ücretsiz: https://aistudio.google.com -> Get API key (kart gerekmez, senaryo yazımı için)
GEMINI_API_KEY=

# Gemini AI Pro hesaplarının tarayıcı profilleri, ; ile ayrılmış
GEMINI_PROFILLER=C:\BotProfil1;C:\BotProfil2
# Hesap başına günlük video hakkı
GEMINI_GUNLUK_LIMIT=3
# TikTok ve Instagram'a giriş yaptığın profil (boşsa ilk Gemini profili kullanılır)
PAYLASIM_PROFILI=C:\BotProfil1

# İsteğe bağlı: youtube_token.json yerine token JSON'u tek satır
YOUTUBE_TOKEN_SPODERMAN=

# Sadece kart eklenirse
AYRSHARE_API_KEY=
AYRSHARE_PROFILE_SPODERMAN=
